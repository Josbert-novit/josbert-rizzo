# Conexión a la planta (red planta-lan, ver ../academia2026-tp/docs/contrato.md)
MQTT_HOST=broker
MQTT_PORT=1883
HISTORIAN_URL=http://sim:8100
HTTP_PROXY=http://enlace:3128
HTTPS_PROXY=http://enlace:3128
NO_PROXY=broker,sim,localhost

# Postgres + pgvector (propio, no es de la planta)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=sistema
POSTGRES_USER=sistema
POSTGRES_PASSWORD=sistema

# Modelos
TRANSCRIPCION_MODELO_LOCAL=small
OLLAMA_URL=http://ollama:11434
LLM_MODELO_EXTRACCION=qwen2.5:1.5b

# Visión multimodal (Entrega 2, Fase 13): análisis de fotos vía NVIDIA NIM (API compatible
# OpenAI). Conseguir la API key gratuita en build.nvidia.com.
NVIDIA_API_KEY=
NVIDIA_MODELO_VISION=nvidia/nemotron-3.5-super-vl-120b-a12b
